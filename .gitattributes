# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched,
*               text=auto

# These files are text and should be normalized
*.gitattributes text
.gitignore      text
*.md            text diff=markdown
*.zs            text
*.zsc           text

# Exclude files from being exported during `git archive`
.gitattributes  export-ignore
.gitignore      export-ignore
.gitkeep        export-ignore
.github         export-ignore

# Enable syntax highlighting for files with '.gitattributes' extensions
*.gitattributes linguist-language=gitattributes
*.gitattributes linguist-detectable=true
*.gitattributes linguist-documentation=false

# Enable syntax highlighting for files with '.zs' and '.zsc' extensions
*.zs            linguist-language=C#
*.zs            linguist-detectable=true
*.zs            linguist-documentation=false
*.zsc           linguist-language=C#
*.zsc           linguist-detectable=true
*.zsc           linguist-documentation=false