class HDCoreShotgun : HDShotgun abstract {

    // The Octal Array of the rounds currently in your hand
    uint handShells;

    // SNDINF Entries
    string distantSound;       property distantSound:distantSound;
    string rackBakSound;       property rackBakSound:rackBakSound;
    string rackFwdSound;       property rackFwdSound:rackFwdSound;
    string openSound;          property openSound:openSound;
    string reloadSound;        property reloadSound:reloadSound;
    string reloadChamberSound; property reloadChamberSound:reloadChamberSound;
    string shotSound;          property shotSound:shotSound;
    string unloadChamberSound; property unloadChamberSound:unloadChamberSound;

    default {
        HDCoreShotgun.distantSound       "world/shotgunFar";
        HDCoreShotgun.openSound          "weapons/huntOpen";
        HDCoreShotgun.rackBakSound       "weapons/huntRackBak";
        HDCoreShotgun.rackFwdSound       "weapons/huntRackFwd";
        HDCoreShotgun.reloadSound        "weapons/huntReload";
        HDCoreShotgun.reloadChamberSound "weapons/huntReloadChamber";
        HDCoreShotgun.shotSound          "weapons/hunter";
        HDCoreShotgun.unloadChamberSound "weapons/huntUnloadChamber";
    }

    // override bool AddSpareWeapon(Actor newOwner) { return AddSpareWeaponRegular(newOwner); }
    // override hdweapon GetSpareWeapon(Actor newOwner, bool reverse, bool doselect) { return GetSpareWeaponRegular(newOwner, reverse, doSelect); }

    /**
     * Translates the given Octal value into the HDB class associated
     *   - 000 -> Nothing (Default)
     *   - 001 -> HDB_00
     *   - 010 -> HDB_Slug
     *   - 011 -> HDB_FlechetteShell
     *   - 100 -> HDB_12GuageSlugMissile
     *   - 101 -> HDB_00Rubber
     *   - 110 -> HDB_FlareMissile
     */
    clearscope static name,int getShellBullet(uint octal) {
        switch (octal) {
            case HDC_SHELLTYPE_FLARE:
                return 'HDB_FlareMissile', 1;
            case HDC_SHELLTYPE_LESSLETHAL:
                return 'HDB_00Rubber', 10;
            case HDC_SHELLTYPE_EXPLOSIVE:
                return 'HDB_12GuageSlugMissile', 1;
            case HDC_SHELLTYPE_FLECHETTE:
                return 'HDB_6mmFlechette', 6;
                // return 'HDB_FlechetteShell', 6;
            case HDC_SHELLTYPE_SLUG:
                return 'HDB_Slug', 1;
            case HDC_SHELLTYPE_SHELL:
                return 'HDB_00', 10;
            default:
                HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "Unknown HDBulletActor for Octal Value: "..HDCore.octalToString(octal)..".  Returning 'None'.");
                return 'None', 0;
        }
    }

    /**
     * Translates the given Octal value into the HDAmmo class associated
     *   - 000 -> Nothing (Default)
     *   - 001 -> HDShellAmmo
     *   - 010 -> HDSlugAmmo
     *   - 011 -> HDFlechetteShellAmmo
     *   - 100 -> HDExplosiveShellAmmo
     *   - 101 -> HDLLShellAmmo
     *   - 110 -> HDFlareAmmo
     */
    clearscope static name getShellAmmo(uint octal) {
        switch (octal) {
            case HDC_SHELLTYPE_FLARE:
                return 'HDFlareAmmo';
            case HDC_SHELLTYPE_LESSLETHAL:
                return 'HDLLShellAmmo';
            case HDC_SHELLTYPE_EXPLOSIVE:
                return 'HDExplosiveShellAmmo';
            case HDC_SHELLTYPE_FLECHETTE:
                return 'HDFlechetteShellAmmo';
            case HDC_SHELLTYPE_SLUG:
                return 'HDSlugAmmo';
            case HDC_SHELLTYPE_SHELL:
                return 'HDShellAmmo';
            default:
                HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "Unknown ShellAmmo for Octal Value: "..HDCore.octalToString(octal)..".  Returning 'None'.");
                return 'None';
        }
    }

    /**
     * Translates the given Octal value into the ShellBox Pickup class associated
     *   - 000 -> Nothing (Default)
     *   - 001 -> ShellBoxPickup
     *   - 010 -> SlugBoxPickup
     *   - 011 -> HDFlechetteShellBoxPickup
     *   - 100 -> ExplosiveShellBoxPickup
     *   - 101 -> LLShellBoxPickup
     *   - 110 -> FlareShellBoxPickup
     */
    clearscope static name getShellBox(uint octal) {
        switch (octal) {
            case HDC_SHELLTYPE_FLARE:
                return 'FlareShellBoxPickup';
            case HDC_SHELLTYPE_LESSLETHAL:
                return 'LLShellBoxPickup';
            case HDC_SHELLTYPE_EXPLOSIVE:
                return 'ExplosiveShellBoxPickup';
            case HDC_SHELLTYPE_FLECHETTE:
                return 'HDFlechetteShellBoxPickup';
            case HDC_SHELLTYPE_SLUG:
                return 'SlugBoxPickup';
            case HDC_SHELLTYPE_SHELL:
                return 'ShellBoxPickup';
            default:
                HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "Unknown ShellBox for Octal Value: "..HDCore.octalToString(octal)..".  Returning 'None'.");
                return 'None';
        }
    }

    /**
     * Translates the given Octal value into the Inventory Icon associated
     *   - 000 -> Nothing (Default)
     *   - 001 -> SHL1A0
     *   - 010 -> SLG1A0
     *   - 011 -> SHF1A0
     *   - 100 -> XLS1A0
     *   - 101 -> LLS1A0
     *   - 110 -> FLARA0
     */
    clearscope static name getShellIcon(uint octal) {
        switch (octal) {
            case HDC_SHELLTYPE_FLARE:
                return 'FLARA0';
            case HDC_SHELLTYPE_LESSLETHAL:
                return 'LLS1A0';
            case HDC_SHELLTYPE_EXPLOSIVE:
                return 'XLS1A0';
            case HDC_SHELLTYPE_FLECHETTE:
                return 'SHF1A0';
            case HDC_SHELLTYPE_SLUG:
                return 'SLG1A0';
            case HDC_SHELLTYPE_SHELL:
                return 'SHL1A0';
            default:
                HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "Unknown ShellAmmo for Octal Value: "..HDCore.octalToString(octal)..".  Returning 'None'.");
                return 'None';
        }
    }

    /**
     * Translates the given Octal value into the Ammo Pickup class associated
     *   - 000 -> Nothing (Default)
     *   - 001 -> ShellPickup
     *   - 010 -> SlugPickup
     *   - 011 -> FlechetteShellPickup
     *   - 100 -> ExplosiveShellPickup
     *   - 101 -> LLShellPickup
     *   - 110 -> FlareShellPickup
     */
    clearscope static name getShellPickup(uint octal) {
        switch (octal) {
            case HDC_SHELLTYPE_FLARE:
                return 'FlareShellPickup';
            case HDC_SHELLTYPE_LESSLETHAL:
                return 'LLShellPickup';
            case HDC_SHELLTYPE_EXPLOSIVE:
                return 'ExplosiveShellPickup';
            case HDC_SHELLTYPE_FLECHETTE:
                return 'FlechetteShellPickup';
            case HDC_SHELLTYPE_SLUG:
                return 'SlugPickup';
            case HDC_SHELLTYPE_SHELL:
                return 'ShellPickup';
            default:
                HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "Unknown ShellPickup for Octal Value: "..HDCore.octalToString(octal)..".  Returning 'None'.");
                return 'None';
        }
    }

    /**
     * Translates the given Octal value into the Fumbling Shell class associated
     *   - 000 -> Nothing (Default)
     *   - 001 -> HDFumblingShell
     *   - 010 -> HDFumblingSlug
     *   - 011 -> HDFumblingFlechetteShell
     *   - 100 -> HDFumblingExplosiveShell
     *   - 101 -> HDLLFumblingShell
     *   - 110 -> HDFlareAmmo [MISSING FUMBLING FLARE SHELL]
     */
    clearscope static name getFumblingShell(uint octal) {
        switch (octal) {
            case HDC_SHELLTYPE_FLARE:
                return 'HDFlareAmmo';
            case HDC_SHELLTYPE_LESSLETHAL:
                return 'HDLLFumblingShell';
            case HDC_SHELLTYPE_EXPLOSIVE:
                return 'HDFumblingExplosiveShell';
            case HDC_SHELLTYPE_FLECHETTE:
                return 'HDFumblingFlechetteShell';
            case HDC_SHELLTYPE_SLUG:
                return 'HDFumblingSlug';
            case HDC_SHELLTYPE_SHELL:
                return 'HDFumblingShell';
            default:
                HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "Unknown Fumbling Shell for Octal Value: "..HDCore.octalToString(octal)..".  Returning 'None'.");
                return 'None';
        }
    }

    /**
     * Translates the given Octal value into the Spent Shell Casing class associated
     *   - 000 -> Nothing (Default)
     *   - 001 -> HDSpentShell
     *   - 010 -> HDSpentSlug
     *   - 011 -> HDSpentFlechetteShell
     *   - 100 -> HDSpentExplosiveShell
     *   - 101 -> HDLLSpentShell
     *   - 110 -> HDSpentShell [MISSING SPENT FLARE SHELL]
     */
    clearscope static name getSpentShell(uint octal) {
        switch (octal) {
            case HDC_SHELLTYPE_FLARE:
                return 'HDSpentShell';
            case HDC_SHELLTYPE_LESSLETHAL:
                return 'HDLLSpentShell';
            case HDC_SHELLTYPE_EXPLOSIVE:
                return 'HDSpentExplosiveShell';
            case HDC_SHELLTYPE_FLECHETTE:
                return 'HDSpentFlechetteShell';
            case HDC_SHELLTYPE_SLUG:
                return 'HDSpentSlug';
            case HDC_SHELLTYPE_SHELL:
                return 'HDSpentShell';
            default:
                HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "Unknown Fumbling Shell for Octal Value: "..HDCore.octalToString(octal)..".  Returning 'None'.");
                return 'None';
        }
    }

    /**
     * Translates the given Octal value into the Unspent Shell class associated
     *   - 000 -> Nothing (Default)
     *   - 001 -> HDUnSpentShell
     *   - 010 -> HDUnSpentSlug
     *   - 011 -> HDUnSpentFlechetteShell
     *   - 100 -> HDUnSpentExplosiveShell
     *   - 101 -> HDLLFumblingShell [MISSING UNSPENT LL SHELL]
     *   - 110 -> HDFlareAmmo [MISSING SPENT FLARE SHELL]
     */
    clearscope static name getUnSpentShell(uint octal) {
        switch (octal) {
            case HDC_SHELLTYPE_FLARE:
                return 'HDFlareAmmo';
            case HDC_SHELLTYPE_LESSLETHAL:
                return 'HDLLFumblingShell';
            case HDC_SHELLTYPE_EXPLOSIVE:
                return 'HDUnSpentExplosiveShell';
            case HDC_SHELLTYPE_FLECHETTE:
                return 'HDUnSpentFlechetteShell';
            case HDC_SHELLTYPE_SLUG:
                return 'HDUnSpentSlug';
            case HDC_SHELLTYPE_SHELL:
                return 'HDUnSpentShell';
            default:
                HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "Unknown Fumbling Shell for Octal Value: "..HDCore.octalToString(octal)..".  Returning 'HDUnSpentShell'.");
                return 'HDUnSpentShell';
        }
    }

    /**
     * Draws the given Shell Type as a vector to the given StatusBar, with the given parameters.
     *   - 000 -> Simple Shell (Default)
     *   - 001 -> HDUnSpentShell
     *   - 010 -> HDUnSpentSlug
     *   - 011 -> HDUnSpentFlechetteShell
     *   - 100 -> HDUnSpentExplosiveShell
     *   - 101 -> HDLLFumblingShell [MISSING UNSPENT LL SHELL]
     *   - 110 -> HDFlareAmmo [MISSING SPENT FLARE SHELL]
     */
    ui static void drawShell(HDStatusBar sb, uint octal, Vector2 pos, Color clr = 0x00000000, int rotation = DRAWPREFAB_EW, double scale = 1.0, int flags = BaseStatusBar.DI_SCREEN_CENTER_BOTTOM) {
        if (!clr.a) clr = getShellColor(octal);
        if (!clr.a) clr = Color(255, sb.sbColour.r, sb.sbColour.g, sb.sbColour.b);

        switch (octal) {
            case HDC_SHELLTYPE_SHELL:
            case HDC_SHELLTYPE_FLECHETTE:
            case HDC_SHELLTYPE_LESSLETHAL:
                HDCore.DrawFancyShell(sb, clr, pos, rotation, scale, flags);
                break;
            case HDC_SHELLTYPE_SLUG:
            case HDC_SHELLTYPE_EXPLOSIVE:
                HDCore.DrawFancySlug(sb, clr, pos, rotation, scale, flags);
                break;
            case HDC_SHELLTYPE_FLARE:
            default:
                HDCore.DrawSimpleShell(sb, clr, pos, rotation, scale, flags);
                break;
        }
    }

    /**
     * Translates the given Octal value into the color to be used when drawing it as a vector on the StatusBar
     *   - 000 -> Transparent (Default)
     *   - 001 -> Red
     *   - 010 -> Blue
     *   - 011 -> White
     *   - 100 -> Green
     *   - 101 -> Blue
     *   - 110 -> Red
     */
    clearscope static Color getShellColor(uint octal) {
        switch (octal) {
            case HDC_SHELLTYPE_FLARE:
                return 0xFFFF0000;
            case HDC_SHELLTYPE_LESSLETHAL:
                return 0xFF0000FF;
            case HDC_SHELLTYPE_EXPLOSIVE:
                return 0xFF00FF00;
            case HDC_SHELLTYPE_FLECHETTE:
                return 0xFFFFFFFF;
            case HDC_SHELLTYPE_SLUG:
                return 0xFF0000FF;
            case HDC_SHELLTYPE_SHELL:
                return 0xFFFF0000;
            default:
                HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "Unknown Vector Color for Octal Value: "..HDCore.octalToString(octal)..".  Returning Transparent.");
                return 0x00000000;
        }
    }

    clearscope uint getWeaponStatusOctal(int statusSlot) {
        return HDCore.octalArrayGet(weaponStatus[statusSlot]);
    }

    /**
     * Returns the Octal value of the currently selected round type,
     * stored in the given weapon status slot.
     */
    clearscope uint getSelectedShellType(int statusSlot = HDC_SHOTS_SHELLTYPE) {
        return getWeaponStatusOctal(statusSlot);
    }

    /**
     * Sets the status of the selected round type to the given Octal value (3-bits).
     */
    void setSelectedShellType(uint octal, int statusSlot = HDC_SHOTS_SHELLTYPE) {
        weaponStatus[statusSlot] = HDCore.octalArraySet(weaponStatus[statusSlot], 0, octal);
    }

    /**
     * Increments the selected round type by 1, looping back to the start.
     */
    void selectPrevShellType(int statusSlot = HDC_SHOTS_SHELLTYPE) {
        let type = (getSelectedShellType(statusSlot) + min(8, HDC_SHELLTYPE_TOTAL)) % min(8, HDC_SHELLTYPE_TOTAL + 1);
        setSelectedShellType(!type ? HDC_SHELLTYPE_TOTAL : type, statusSlot);
    }

    /**
     * Decrements the selected round type by 1, looping back to the end.
     */
    void selectNextShellType(int statusSlot = HDC_SHOTS_SHELLTYPE) {
        let type = (getSelectedShellType(statusSlot) + 1) % min(8, HDC_SHELLTYPE_TOTAL + 1);
        setSelectedShellType(!type ? 1 : type, statusSlot);
    }

    /**
     * Returns whether there is a round in the given chamber,
     * as denoted by the bitwise AND against the flag shown
     */
    clearscope bool isRoundChambered(int statusSlot = HDC_SHOTS_CHAMBER) {
        return getChamberedRound(statusSlot);
    }

    /**
     * Returns whether there is a round in the given chamber, and that round is live,
     * as denoted by the bitwise AND against the flags shown
     */
    clearscope bool isChamberedRoundLive(int statusSlot = HDC_SHOTS_CHAMBER) {
        return isRoundChambered(statusSlot) && (weaponStatus[statusSlot] & HDC_SHOTCHAMBF_LIVE);
    }

    /**
     * Returns the Octal value of the round in the given chamber,
     * accounting for the two flags used for presence & "live"-ness
     */
    clearscope uint getChamberedRound(int statusSlot = HDC_SHOTS_CHAMBER) {
        return getWeaponStatusOctal(statusSlot);
    }

    /**
     * Sets the status of the given chamber to the given Octal value (3-bits),
     * as well as setting both flags for the presence and "live-ness" of said round.
     */
    void setChamberedRound(uint octal, int statusSlot = HDC_SHOTS_CHAMBER) {
        if (octal & 7) {
            weaponStatus[statusSlot] = (octal & 7)|HDC_SHOTCHAMBF_LIVE;
        } else {
            clearChamberedRound(statusSlot);
        }
    }

    /**
     * Clears the status of the given chamber.
     */
    void clearChamberedRound(int statusSlot = HDC_SHOTS_CHAMBER) {
        weaponStatus[statusSlot] = 0;
    }

    /**
     * Clears and returns the removed round from the given chamber.
     */
    uint removeChamberedRound(int statusSlot = HDC_SHOTS_CHAMBER) {
        let round = getChamberedRound(statusSlot);

        clearChamberedRound(statusSlot);

        return round;
    }

    /**
     * Returns the number of rounds in the given tube,
     * treating it as an Octal Array, and thus
     * returning the number of non-zero octals
     */
    clearscope uint getNumTubeRounds(int statusSlot = HDC_SHOTS_TUBE) {
        return HDCore.OctalArrayLength(weaponStatus[statusSlot]);
    }

    /**
     * Returns whether the given tube has at least as many rounds in it as it can hold
     */
    clearscope bool isTubeFull(int statusSlot = HDC_SHOTS_TUBE, int max = 0) {
        return getNumTubeRounds(statusSlot) >= min(10, max > 0 ? max : weaponStatus[HDC_SHOTS_TUBESIZE]);
    }

    /**
     * Attempts to push a new Octal value into the tube, if there's room.
     * returns true if a new value was inserted, otherwise false.
     */
    bool pushTubeRound(uint octal, int statusSlot = HDC_SHOTS_TUBE) {

        // If we have at least the number of rounds in the tube that it'll fit, quit.
        if (isTubeFull(statusSlot)) return false;

        // Push the new octal into the given tube.
        weaponStatus[statusSlot] = HDCore.octalArrayPush(weaponStatus[statusSlot], octal);

        return true;
    }

    /**
     * Pops the round out of the tube, if there are any.
     * returns the octal value of the round, or 0 if there was none.
     */
    uint popTubeRound(int statusSlot = HDC_SHOTS_TUBE) {

        // If the given status slot is empty, simply return.
        if (!weaponStatus[statusSlot]) return 0;

        // Pop the first slot in the Octal Array
        let [octal, tube] = HDCore.octalArrayPop(weaponStatus[statusSlot]);
        weaponStatus[statusSlot] = tube;

        HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "Tube Round Popped: "..HDCore.octalToString(octal)..", new Tube State: "..HDCore.octalArrayToString(weaponStatus[statusSlot])..".");

        // Return whatever was given above.
        return octal;
    }

    clearscope uint getNumHandShells() {
        return HDCore.OctalArrayLength(handShells);
    }

    clearscope bool getWepStatusFlag(int flag, int statusSlot = 0) {
        return weaponStatus[statusSlot] & flag;
    }

    action void A_SetWepStatusFlags(int flags, bool value, int statusSlot = 0) {
        if (value) {
            invoker.weaponStatus[statusSlot] |= flags;
        } else {
            invoker.weaponStatus[statusSlot] &= ~flags;
        }
    }

    action void A_Chamber(int chamberSlot = HDC_SHOTS_CHAMBER, int tubeSlot = HDC_SHOTS_TUBE, bool careful = false) {
        let round = invoker.isRoundChambered(chamberSlot);
        let live  = invoker.isChamberedRoundLive(chamberSlot);
        int type  = invoker.removeChamberedRound(chamberSlot);

        let rnd = invoker.popTubeRound(tubeSlot);

        if (rnd) {
            invoker.setChamberedRound(rnd, chamberSlot);
        } else {
            invoker.clearChamberedRound(chamberSlot);
        }

        Vector3 cockdir;
        double cp = cos(pitch);

        if (careful) {
            cockdir = (-cp, cp, -5);
        } else {
            cockdir = (0, -cp * 5, sin(pitch) * frandom(4, 6));
        }

        cockdir.xy = RotateVector(cockdir.xy, angle) * (round ? frandom(1.0, 1.3) : 1.0);

        if (live && careful && !A_JumpIfInventory(invoker.getShellAmmo(type), 0, "null")) {
            HDF.Give(self, invoker.getShellAmmo(type), 1);
        } else if (round) {
            Vector3 gunofs = HDMath.RotateVec3D((9, -1, -2), angle, pitch);

            Actor rrr = spawn(
                live ? invoker.getFumblingShell(type) : invoker.getSpentShell(type),
                (pos.xy, pos.z + height * 0.85) + gunofs + viewpos.offset
            );

            if (!rrr) return;

            rrr.target = self;
            rrr.angle = angle;
            rrr.vel = HDMath.RotateVec3D((1, -5, 0.2), angle, pitch);

            if (!live) rrr.vel *= 1.3;

            rrr.vel += vel;
        }
    }

    action void A_AddToHand(uint octal) {
        while (octal) {
            invoker.handShells = HDCore.octalArrayPush(invoker.handShells, octal);
            octal = octal >> 3;
        }
    }

    action bool A_LoadChamberFromHand(int statusSlot = HDC_SHOTS_CHAMBER) {

        // Get single round Octal value from hand
        let [round, hand] = HDCore.octalArrayPop(invoker.handShells);

        // If we didn't get anything, or if the chamber has a round,
        // empty the hand and return false
        if (!round || invoker.isRoundChambered()) {
            A_EmptyHand(careful: true);
            return false;
        }

        // Put the round from the hand into the chamber
        invoker.setChamberedRound(round);

        // Put remaining rounds back in pockets.
        invoker.handShells = hand;
        A_EmptyHand(careful: true);

        A_StartSound(invoker.reloadChamberSound, 8, CHANF_OVERLAP);

        return true;
    }

    action bool A_LoadTubeFromHand(int statusSlot = HDC_SHOTS_TUBE) {

        // Get single round Octal value from hand
        let [round, hand] = HDCore.octalArrayPop(invoker.handShells);
        
        // If we didn't get anything, or if the tube is full,
        // empty the hand and return false
        if (!round || (!invoker.isRoundChambered() && invoker.isTubeFull(statusSlot))) {
            A_EmptyHand(careful: true);
            return false;
        }

        // Push the round from the hand into the tube
        invoker.pushTubeRound(round);

        // Put the remaining rounds back in hand
        invoker.handShells = hand;

        A_StartSound(invoker.reloadSound, 8, CHANF_OVERLAP);

        return true;
    }

    action bool A_GrabShells(int maxHand = 3, bool setTics = false, bool alwaysOne = false) {

        if (maxHand > 0) {
            A_EmptyHand();
        } else {
            maxHand = abs(maxHand);
        }

        // TODO: implement sidesaddle support
        /*
            bool fromsidesaddles = !(invoker.weaponStatus[0]&HUNTF_FROMPOCKETS);
            int toload = min(
                fromsidesaddles ? invoker.weaponStatus[SHOTS_SIDESADDLE] : countinv("HDShellAmmo"),
                alwaysone ? 1 : (invoker.weaponStatus[HUNTS_TUBESIZE] - invoker.weaponStatus[HUNTS_TUBE]),
                maxhand
            );
        */

        // Grab the selected round type
        uint type = invoker.getSelectedShellType();

        // Restrict the number of shells to grab
        uint toLoad = min(
            10,
            countinv(invoker.getShellAmmo(type)),
            alwaysOne ? 1 : invoker.weaponStatus[HDC_SHOTS_TUBESIZE] - invoker.getNumTubeRounds(),
            max(1, health / 22),
            maxHand
        );

        // If we've determined we shouldn't grab any, quit.
        if (!toLoad) return false;

        // Add the shells to the hand, one by one
        for (int i = 0; i < toLoad; i++) A_AddToHand(type);

        // TODO: implement sidesaddle support
        /* 
            if(fromsidesaddles){
                invoker.weaponStatus[SHOTS_SIDESADDLE] -= toload;

                if (setTics) A_SetTics(2);

                A_StartSound("weapons/pocket", 8, CHANF_OVERLAP, 0.4);

                A_MuzzleClimb(
                    frandom(0.1, 0.15), frandom(0.05, 0.08),
                    frandom(0.1, 0.15), frandom(0.05, 0.08),
                    wepdot: false
                );
            }else{
        */
        A_TakeInventory(invoker.getShellAmmo(type), toLoad, TIF_NOTAKEINFINITE);

        if (setTics) A_SetTics(7);

        A_StartSound("weapons/pocket", 9);

        A_MuzzleClimb(
            frandom(0.1, 0.15), frandom(0.2, 0.4),
            frandom(0.2, 0.25), frandom(0.3, 0.4),
            frandom(0.1, 0.35), frandom(0.3, 0.4),
            frandom(0.1, 0.15), frandom(0.2, 0.4),
            wepdot: false
        );
        // }

        return true;
    }

    /**
     * Removes the rounds stored in the handShells, like the HDShotgun.
     * Unlike HDShotgun, however, we will treat handShells as an Octal Array
     * rather than a simple number of 12ga Buckshot Shells to remove.
     */
    action void A_EmptyHand(int amt = -1, bool careful = false) {

        HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "amt = "..amt..", careful = "..careful);

        // If we're emptying exactly 0, quit.
        if (!amt) return;
        
        // Get the number of shells in hand
        let numHand = HDCore.octalArrayLength(invoker.handShells);
 
        // If we have no rounds in hand, quit.
        if (!numHand) return;

        HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "Emptying "..amt.."x rounds from hand containing "..numHand.."x rounds...");

        let gps = pos + HDMath.GetGunPos(self);
        while (amt && HDCore.octalArrayLength(invoker.handShells)) {
            HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "amt = "..amt..", handShells = "..invoker.handShells);

            // Pop one shell out of the hand.
            let [shellType, hand] = HDCore.octalArrayPop(invoker.handShells);
            invoker.handShells = hand;

            if (careful && !A_JumpIfInventory(getShellAmmo(shellType), 0, "null")) {
                HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "Giving shellType = "..shellType);
                HDF.Give(self, getshellAmmo(shellType), 1);
            // TODO: determine better way to drop full bundles worth?
            // } else if (invoker.handShells >= 4) {
            //     HDCore.octalArrayPop(invoker.handShells);
            //     dropped = spawn(getShellPickup(shellType), gps);
            } else {
                HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "Dropping shellType = "..shellType);
                Actor dropped = spawn(getFumblingShell(shellType), gps);
                
                if (dropped) {
                    dropped.vel += vel;
                    dropped.angle = angle + frandom(-10, 10);
                    dropped.vel.xy += (cos(dropped.angle), sin(dropped.angle));
                    dropped.vel.z += frandom(0, 1);
                }
            }

            // Decrease the number of shells left to empty, if applicable.
            if (amt > 0) amt--;

            HDCore.log('HDCoreShotgun', LOGGING_DEBUG, "amt = "..amt);
        }
    }

    override void DropOneAmmo(int amt) {
        if (owner) {
            amt = clamp(amt, 1, 10);

            owner.A_DropInventory(getShellAmmo(getSelectedShellType()), amt * 4);
        }
    }

    override void ForceBasicAmmo() {

        // TODO: Determine what needs to happen here
        owner.A_SetInventory(getShellAmmo(getSelectedShellType()), 4);
    }

    override void detachFromOwner() {
        if (handShells > 0) A_EmptyHand();

        super.detachFromOwner();
    }

	double FireShell(int statusSlot = HDC_SHOTS_CHAMBER, double spread = 3.5, double speedFactor = 1.0) {
		double shotPower = getshotPower();

		spread *= shotPower;
		speedfactor *= shotPower;

        let [rnd, num] = getShellBullet(getChamberedRound(statusSlot));
        if (num > 1) HDBulletActor.FireBullet(owner, "HDB_wad");
		HDBulletActor.FireBullet(owner, rnd, spread: num > 1 ? spread : 0.0, speedfactor: speedFactor, amount: num);
		DistantNoise.make(owner, distantSound);
		A_StartSound(shotSound, CHAN_WEAPON, CHANF_OVERLAP);

		return shotPower;
	}

	action void A_FireShotgun(int statusSlot = HDC_SHOTS_CHAMBER, double spread = 3.5, double speedFactor = 1.0, double recoilMult = 1.0) {

        // Fire the actual round and return the relative shotPower
		double shotPower = invoker.FireShell(statusSlot: statusSlot, spread: spread, speedFactor: speedFactor);

        // Overlay the Muzzle Flash
		A_GunFlash();

        // Apply Recoil
		Vector2 shotRecoil = (randompick(-1, 1), -3.2) * shotPower * recoilMult;
		A_ZoomRecoil(0.855 * shotPower * recoilMult);
		A_MuzzleClimb(
			0, 0,
			shotrecoil.x, shotrecoil.y,
			randompick(-2, 4) * shotPower * recoilMult, -1.3 * shotPower * recoilMult
		);

        // Clear the "Live Round" flag
		invoker.weaponStatus[statusSlot] &= ~HDC_SHOTCHAMBF_LIVE;

        // apply the relative shotPower onto the weapon
		invoker.shotPower = shotPower;
	}

    action void A_PushShotgunTube(uint octal, int statusSlot = HDC_SHOTS_TUBE) {
        invoker.pushTubeRound(octal, statusSlot);
    }

    override void initializeWepStats(bool idfa) {
        super.initializeWepStats(idfa);

        if (!weaponStatus[HDC_SHOTS_SHELLTYPE]) weaponStatus[HDC_SHOTS_SHELLTYPE] = 1;
        if (!weaponStatus[HDC_SHOTS_TUBESIZE]) weaponStatus[HDC_SHOTS_TUBESIZE] = 10;

        setChamberedRound(weaponStatus[HDC_SHOTS_SHELLTYPE]);
        while (!isTubeFull()) pushTubeRound(weaponStatus[HDC_SHOTS_SHELLTYPE]);
    }
}

enum ShellTypes {
    HDC_SHELLTYPE_NONE       = 0,
    HDC_SHELLTYPE_SHELL      = 1,
    HDC_SHELLTYPE_SLUG       = 2,
    HDC_SHELLTYPE_FLECHETTE  = 3,
    HDC_SHELLTYPE_EXPLOSIVE  = 4,
    HDC_SHELLTYPE_LESSLETHAL = 5,
    HDC_SHELLTYPE_FLARE      = 6,
    HDC_SHELLTYPE_TOTAL      = 6
}

enum HDCoreShotgunStatus {
    HDC_SHOTS_CHAMBER    = 1,    // Octal value of round in chamber, lowest two (right-most) bits reserved for loaded/live flags
    HDC_SHOTS_TUBE       = 2,    // Octal Array of rounds in tube magazine
    // SHOTS_SIDESADDLE  = 3,    // From HDShotgun
    HDC_SHOTS_TUBESIZE   = 4,    // Number of rounds the tube magazine can hold
    HDC_SHOTS_SHELLTYPE  = 5,    // The Octal value of the currently selected round to load from inventory

    HDC_SHOTF_ALTHOLDING = 1,

    HDC_SHOTCHAMBF_LIVE  = 1 << 31,
}